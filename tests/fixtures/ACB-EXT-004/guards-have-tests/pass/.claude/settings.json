{
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Edit(~/.claude/**)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(.mcp.json)",
      "Bash(claude plugin *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/hooks/block-writes.sh"
          }
        ]
      }
    ]
  }
}
