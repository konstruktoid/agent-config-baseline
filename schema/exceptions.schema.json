{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/konstruktoid/agent-config-baseline/schema/exceptions.schema.json",
  "title": "acb exceptions file",
  "description": "The single reviewed exceptions file (--exceptions, default ./.acb-exceptions.yaml relative to the working directory). Never read from inside the scanned PATH.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["control", "path", "justification", "approver", "expires"],
    "properties": {
      "control": { "type": "string", "pattern": "^ACB-(SKILL|INSTR|MCP|GEN|PROV)-[0-9]{3}$" },
      "path": { "type": "string", "minLength": 1 },
      "justification": { "type": "string", "minLength": 1 },
      "approver": { "type": "string", "minLength": 1 },
      "expires": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
    }
  }
}
